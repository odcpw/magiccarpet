    "content_ordered_fields": [
      "sequence:u64",
      "state_hash:u64",
      "kind:u32",
      "code:u32",
      "entity_index:u16",
      "player_index:i16",
      "value0:i32",
      "value1:i32",
      "asset_ref_index:u32"
    ],
    "lifecycle_schema": "mc2-native-event-logical-lifecycle-le/sha256-v1",
    "lifecycle_rule": "prepend generation:u64 to every event before the content fields",
    "excluded": ["abi_version", "struct_size", "reserved ABI bytes"]
  },
